<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS — reverse proxy for Maputo Blue (alternative to Caddy).
  Requires: URL Rewrite + Application Request Routing (ARR) with "Enable proxy",
  and, at server level (once, elevated):
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /preserveHostHeader:"True" /commit:apphost
    %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
  Copy this file to the root folder of the IIS site (an empty folder is enough:
  Node serves the files). Certificate: win-acme (Let's Encrypt). See docs/IMPLANTACAO.md §6.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://maputoblue.co.mz/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.maputoblue\.co\.mz$" />
          </conditions>
          <action type="Redirect" url="https://maputoblue.co.mz/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Node" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Let Node's own error pages and JSON errors through -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <!-- 250 MB: photo uploads in the admin panel -->
        <requestLimits maxAllowedContentLength="262144000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
