# ── Maputo Blue server configuration ──────────────────────────────────────────
# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# PostgreSQL connection (database must be UTF8)
DATABASE_URL=postgres://maputoblue:CHANGE_ME@127.0.0.1:5432/maputoblue
# Public URL of the site (used in e-mail links and the CSRF origin check)
PUBLIC_BASE_URL=https://www.maputoblue.com
# Set to true when running behind IIS / Caddy / Nginx
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_DAYS=14
# E-mail (Resend) — https://resend.com/api-keys ; domain must be verified
RESEND_API_KEY=
MAIL_FROM=Maputo Blue <reservas@maputoblue.com>
MAIL_REPLY_TO=maputoblue.info@gmail.com
# Random string used to hash IP addresses in logs (generate once)
IP_HASH_SALT=CHANGE_ME_RANDOM
# Signs ticket QR codes (required in production). Never change it after tickets are issued.
TICKET_SECRET=CHANGE_ME_RANDOM
# Serve the static website from this process (true) or only the API (false)
SERVE_STATIC=true
RUN_JOBS=true
