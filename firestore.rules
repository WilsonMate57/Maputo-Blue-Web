rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reviews collection ──────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Allow creation with basic validation
      allow create: if
        request.resource.data.keys().hasAll(['packageId', 'name', 'rating', 'comment', 'createdAt']) &&
        request.resource.data.packageId is string &&
        request.resource.data.packageId.size() > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 &&
        request.resource.data.comment.size() <= 1000;

      // No updates or deletes from the client
      allow update, delete: if false;
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
